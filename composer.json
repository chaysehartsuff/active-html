{
    "name": "chaysehartsuff/active-html",
    "description": "A centralized JS/PHP bridge for Eloquent models and active HTML components.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Chayse Hartsuff",
            "email": "your-email@example.com"
        }
    ],
    "autoload": {
        "psr-4": {
            "ChayseHartsuff\\ActiveHtml\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "ChayseHartsuff\\ActiveHtml\\ActiveHtmlServiceProvider"
            ]
        }
    },
    "require": {
        "php": "^8.1|^8.2|^8.3",
        "illuminate/support": "^10.0|^11.0|^12.0"
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}